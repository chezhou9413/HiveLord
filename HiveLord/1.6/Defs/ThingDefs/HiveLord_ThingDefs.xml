<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="HiveLordProjectionBase" ParentName="BuildingBase">
    <defName>HiveLord_Projection</defName>
    <label>hive lord</label>
    <description>A colossal insect that hunts beneath the ground. It follows the movement of its enemies, surfacing to spit acid or drive its immense body into the earth.\n\nIts heavy carapace limits health damage to 100 per hit. Watch for tremors and attack warnings, then concentrate fire while it is above ground.</description>
    <thingClass>HiveLordLib.HiveLordProjectionThing</thingClass>
    <category>Building</category>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useHitPoints>false</useHitPoints>
    <isAutoAttackableMapObject>false</isAutoAttackableMapObject>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(1,1)</size>
    <building>
      <claimable>false</claimable>
      <isTargetable>false</isTargetable>
      <isEdifice>false</isEdifice>
      <repairable>false</repairable>
    </building>
    <modExtensions>
      <li Class="HiveLordLib.HiveLordCombatExtension">
        <targetSearchIntervalTicks>60</targetSearchIntervalTicks>
        <targetSearchRadius>10000</targetSearchRadius>
        <targetRetentionRadius>10000</targetRetentionRadius>
        <acidAttackChance>0.6</acidAttackChance>
        <acidEmergenceMinRadius>20</acidEmergenceMinRadius>
        <acidEmergenceMaxRadius>30</acidEmergenceMaxRadius>
        <acidMaxRange>55</acidMaxRange>
        <slamEmergenceMinRadius>6</slamEmergenceMinRadius>
        <slamEmergenceMaxRadius>10</slamEmergenceMaxRadius>
        <slamMaxRange>16</slamMaxRange>
        <surfaceIdleTicks>150</surfaceIdleTicks>
        <undergroundTravelTicks>360</undergroundTravelTicks>
        <undergroundRestMinTicks>180</undergroundRestMinTicks>
        <undergroundRestMaxTicks>480</undergroundRestMaxTicks>
        <attackRecoveryTicks>27</attackRecoveryTicks>
        <submergingHideDelayTicks>18</submergingHideDelayTicks>
        <groundFeedbackTicks>150</groundFeedbackTicks>
        <acidGroundDurationTicks>720</acidGroundDurationTicks>
        <emergenceShockwaveNormalizedTime>0.68</emergenceShockwaveNormalizedTime>
        <emergencePushRadius>24</emergencePushRadius>
        <emergencePushMinDistance>16</emergencePushMinDistance>
        <emergencePushMaxDistance>28</emergencePushMaxDistance>
        <emergenceShockwaveScale>14</emergenceShockwaveScale>
        <emergenceExitNormalizedTime>1</emergenceExitNormalizedTime>
        <submergingExitNormalizedTime>1</submergingExitNormalizedTime>
        <acidImpactNormalizedTime>0.6</acidImpactNormalizedTime>
        <slamImpactNormalizedTime>0.4</slamImpactNormalizedTime>
        <acidEmissionStartNormalizedTime>0.42</acidEmissionStartNormalizedTime>
        <acidEmissionEndNormalizedTime>0.68</acidEmissionEndNormalizedTime>
        <attackExitNormalizedTime>0.9</attackExitNormalizedTime>
        <emergenceShakeMagnitude>0.09</emergenceShakeMagnitude>
        <acidShakeMagnitude>0.055</acidShakeMagnitude>
        <slamShakeMagnitude>0.14</slamShakeMagnitude>
        <submergingShakeMagnitude>0.065</submergingShakeMagnitude>
        <screenShakeDistance>85</screenShakeDistance>
        <acidAreaStartOffset>4</acidAreaStartOffset>
        <acidAreaLength>60</acidAreaLength>
        <acidAreaNearHalfWidth>8</acidAreaNearHalfWidth>
        <acidAreaFarHalfWidth>18</acidAreaFarHalfWidth>
        <acidDamage>60</acidDamage>
        <acidArmorPenetration>0.35</acidArmorPenetration>
        <slamAreaBackLength>16</slamAreaBackLength>
        <slamAreaForwardLength>52</slamAreaForwardLength>
        <slamAreaHalfWidth>16</slamAreaHalfWidth>
        <slamDamage>45</slamDamage>
        <slamArmorPenetration>0.35</slamArmorPenetration>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>Things/HiveLord/HiveLord_Invisible</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
  <ThingDef Name="HiveLordHitProxyBase" ParentName="BuildingBase">
    <defName>HiveLord_HitProxy</defName>
    <label>hive lord</label>
    <description>A colossal insect that hunts beneath the ground. It follows the movement of its enemies, surfacing to spit acid or drive its immense body into the earth.\n\nIts heavy carapace limits health damage to 100 per hit. Watch for tremors and attack warnings, then concentrate fire while it is above ground.</description>
    <thingClass>HiveLordLib.HiveLordHitProxy</thingClass>
    <category>Building</category>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Never</tickerType>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useHitPoints>true</useHitPoints>
    <drawGUIOverlay>false</drawGUIOverlay>
    <drawDamagedOverlay>false</drawDamagedOverlay>
    <isAutoAttackableMapObject>true</isAutoAttackableMapObject>
    <seeThroughFog>true</seeThroughFog>
    <rotatable>false</rotatable>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(21,21)</size>
    <building>
      <claimable>false</claimable>
      <isTargetable>true</isTargetable>
      <isEdifice>false</isEdifice>
      <repairable>false</repairable>
    </building>
    <statBases>
      <MaxHitPoints>24000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>10000</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/HiveLord/HiveLord_Invisible</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
